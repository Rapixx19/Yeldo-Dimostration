// Yeldo deal tracker — Prisma schema
// See docs/01-database-schema.md for the spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Instrument {
  senior_loan
  mezzanine
  senior_debt
  secured_mezzanine
}

enum Distribution {
  quarterly
  at_maturity
}

enum DealStatus {
  open
  closed
  exited
}

enum SentimentLabel {
  bullish
  neutral
  cautious
}

model User {
  // id matches auth.users.id from Supabase Auth — populated by a trigger
  // (see migration 20260526_auth_to_supabase). Public.users holds app-domain
  // fields; auth.users holds credentials and provider tokens.
  id          String       @id @db.Uuid
  email       String       @unique
  name        String
  avatarUrl   String?
  createdAt   DateTime     @default(now())
  investments Investment[]

  @@map("users")
}

model Deal {
  id            String     @id @default(cuid())
  slug          String     @unique
  name          String
  location      String
  country       String // ISO 3166-1 alpha-2 (IT, ES, CH, DE, PT)
  assetClass    String // "Hospitality", "Residential", etc.
  instrument    Instrument
  targetRaise   Float
  raisedAmount  Float
  targetIRR     Float
  maturityMonths Int
  loanToValue   Float
  distribution  Distribution
  minimumTicket Float
  status        DealStatus @default(open)
  startDate     DateTime
  maturityDate  DateTime
  closesAt      DateTime?

  // FinBERT sentiment fields (computed at seed time, see docs/12-finbert-sentiment.md)
  sentimentLabel   SentimentLabel
  sentimentScore   Float
  sentimentSignals Json

  // Sponsor info
  sponsorName          String
  sponsorDescription   String
  hasFirstLienMortgage Boolean @default(true)

  // Risk profile — array of { category, severity, note }
  risks Json

  // Description / memo
  description String  @db.Text
  imageUrl    String?

  // pgvector embedding for semantic search (V2 B1). Prisma has no native
  // vector type, so this maps as Unsupported — we query it via $queryRaw
  // in services/semanticSearch.ts, where pgvector's <=> operator lives.
  embedding   Unsupported("vector(1536)")?

  createdAt   DateTime     @default(now())
  investments Investment[]
  events      DealEvent[]

  @@map("deals")
}

model DealEvent {
  id        String   @id @default(cuid())
  dealId    String
  eventType String // 'launch' | 'milestone' | 'news' | 'status_change' (free-form so new types don't need a migration)
  message   String
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_events")
}

model Investment {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  dealId     String
  amount     Float
  investedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal Deal @relation(fields: [dealId], references: [id])

  @@index([userId])
  @@index([dealId])
  @@map("investments")
}
