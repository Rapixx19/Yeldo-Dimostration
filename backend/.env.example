# Backend env (copy to .env and fill in)

# Postgres (Supabase pooled connection — use the "Transaction" pooler URL for runtime,
# and the direct connection URL for migrations).
# Get both from: https://supabase.com/dashboard/project/<ref>/settings/database
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase Auth — see https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role key — bypasses RLS, keep secret>"
SUPABASE_JWT_SECRET="<JWT secret from Settings → API → JWT Settings>"

# Seed (creates the demo user in Supabase Auth)
SEED_DEMO_PASSWORD="demo123"

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:5173"
